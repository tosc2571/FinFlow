# Copy this file to .env (same folder as docker-compose.yml) and edit the values there.
# .env is read by `docker compose` itself, not by FinFlow — it only fills in the
# ${...} placeholders in docker-compose.yml, so there's nothing else to configure.

# Where FinFlow stores its data (SQLite database, daily backups, settings.json).
# A plain host folder, not a Docker-managed volume, so it's easy to find and back up.
FINFLOW_DATA_LOCATION=./data

# The port FinFlow is reachable on from outside the container.
FINFLOW_PORT=5199

# Which published image tag to run. "latest" tracks the newest release; pin it to a
# specific version (e.g. v0.3.0) to control upgrades yourself.
FINFLOW_VERSION=latest
