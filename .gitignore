bin/
obj/
.vs/
*.user
*.suo

# Real classification rules contain personal vendor/pattern data — never commit
backend/FinFlow.Cli/rules.json

# Local SQLite database files — schema lives in FinFlow.Api/Migrations, not the .db file itself
*.db
*.db-shm
*.db-wal

# Lives next to the database (dev: next to the project) — a local runtime artifact, not source
settings.json

# Build artifacts of scripts/publish.* (frontend copied into the API + published output)
backend/FinFlow.Api/wwwroot/
publish/

# scripts/finflow.* installs the app here — never commit a local test install
scripts/app/

# User-local docker compose config (copied from .env.example) and its default bind-mounted
# data folder — never commit either, same reasoning as the *.db rule above.
.env
/data/

# Claude Code worktree sessions (parallel-agent isolation) — never commit
.claude/worktrees/

~$*.xlsx
~$*.docx
