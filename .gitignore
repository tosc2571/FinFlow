*.db-wal

# Build artifacts of scripts/publish.* (frontend copied into the API + published output)
backend/FinFlow.Api/wwwroot/
publish/

# scripts/finflow.* installs the app here — never commit a local test install
scripts/app/

# Claude Code worktree sessions (parallel-agent isolation) — never commit
.claude/worktrees/

~$*.xlsx
~$*.docx
